@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@VIBE_ENABLE_MPI@)
  find_dependency(MPI COMPONENTS CXX)
endif()
if(@VIBE_ENABLE_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@VIBE_ENABLE_NETCDF@)
  find_dependency(NetCDF COMPONENTS C)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VibeModelTargets.cmake")

check_required_components(VibeModel)
